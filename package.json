{
  "name": "electron-fetcher",
  "version": "0.1.0",
  "description": "An axios-like HTTP client for the Electron main process built on net.fetch, with interceptors, concurrency limiting, timeouts and an opt-in response cache.",
  "keywords": [
    "electron",
    "fetch",
    "http",
    "interceptors",
    "net",
    "typescript"
  ],
  "homepage": "https://github.com/antelm-dev/electron-fetcher#readme",
  "bugs": "https://github.com/antelm-dev/electron-fetcher/issues",
  "license": "MIT",
  "author": "Adel Terki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antelm-dev/electron-fetcher.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:commits": "commitlint --from HEAD~1 --to HEAD",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run check && pnpm run build"
  },
  "dependencies": {
    "node-cache": "^5.1.2",
    "p-limit": "^7.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.9.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.79.0",
    "publint": "0.3.25",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "electron": ">=25.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
